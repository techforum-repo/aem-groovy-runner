# =========================================================
# AEM Groovy Runner
# Environment Configuration
#
# Every line maps to a field in groovy_runner/config.py's Settings class.
# All of these can also be set on the app's Settings page, which overrides
# these values.
# =========================================================

APP_ENV=development

# true  = sample data, nothing is sent to AEM (try the whole flow first).
# false = live calls to AEM_AUTHOR_URL.
MOCK_MODE=true

# -----------------------------
# AEM author
# -----------------------------
# No trailing slash, e.g. https://author-p12345-e67890.adobeaemcloud.com
AEM_AUTHOR_URL=

# There are no credentials here on purpose. You sign in from the app's sidebar
# with your own Local Development Token (your SSO identity, valid 24h), which
# is kept only in browser-session memory.

# -----------------------------
# Groovy Console
# -----------------------------
GROOVY_CONSOLE_ENDPOINT=/bin/groovyconsole/post.json

# Seconds one script run may take (scripts like the asset-reference report
# can take many minutes on a big DAM folder).
HTTP_TIMEOUT=1800

# Port the start scripts try first (default 8501). If something is already
# running there, they move to the next free port and print the URL.
GROOVY_RUNNER_PORT=8501

# Where results go: <OUTPUT_DIR>/<session>/<script-id>/<run>/<slug>.{json,groovy,xlsx}
OUTPUT_DIR=output
